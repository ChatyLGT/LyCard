generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// MasterN0 when programId is null (global access — the original Phase 1
// single-Admin account). A scoped Program N0 when programId is set: same
// login/session system, but every admin page/action must check this and
// restrict reach to that one Program (PLAN.md Fase 6) — only MasterN0
// creates these scoped accounts, EXCEPT for the row described below.
model Admin {
  id    String  @id @default(cuid())
  // Nullable (2026-09-24, promoción automática Chido→Programa): una fila
  // de Admin nacida de esa promoción no tiene login propio -- su dueño ya
  // tiene sesión de Member (WhatsApp/Google), nunca eligió un
  // email/password de Admin. `email`/`passwordHash` siguen siendo
  // obligatorios para cualquier Admin "clásico" (dado de alta a mano por
  // MasterN0, con su propio login); lib/auth.ts nunca deja loguearse por
  // password/Google a una fila con `passwordHash` null.
  email        String? @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  programId String?
  program   Program? @relation(fields: [programId], references: [id])

  // Link real a Member (2026-09-24) -- cuando existe, esta fila de Admin
  // ES ese Member actuando con autoridad sobre su propio Programa, no una
  // cuenta aparte. lib/auth.ts#currentAdminScope() la resuelve vía la
  // sesión de Member ya activa (lib/memberAuth.ts), sin cookie de Admin
  // propia. Ver PLAN.md, "Modelo de monetización cerrado" (2026-09-24).
  memberId String? @unique
  member   Member? @relation(fields: [memberId], references: [id])

  // Mensajería Interna (2026-09-24) — un N0 "clásico" (email/password,
  // sin Member vinculado) manda como este Admin en vez de como un
  // Member, ver Message.senderAdminId.
  sentMessages Message[]
}

// Bitácora de todo intento de login de Admin, exitoso o no (2026-09-19,
// pedido de Gunnar: "eso también es importante que siempre quede
// registro de eso") — password y Google, los dos métodos. No se borra
// nunca; es el primer paso del futuro CRM/auditoría del panel.
model AdminLoginEvent {
  id        String   @id @default(cuid())
  email     String
  method    String // "password" | "google"
  success   Boolean
  reason    String? // motivo si success=false (ej. "bad_password", "google_not_admin")
  createdAt DateTime @default(now())
}

// One row per LyCard. Multi-tenant roster: the Admin
// creates/edits every card; each card is publicly viewable at /c/[slug].
model Card {
  id        String   @id @default(cuid())
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Identity (STR/state.p in the LyCard.dc.html prototype)
  name    String
  title   String
  quote   String
  siglas  String @default("O.D.")
  tooltip String @default("Order of Distinction")

  // "Mi camino con..." modal on project cards (PLAN.md Fase 9.3) — each
  // host writes their own, editable from /m/dashboard/project. Empty
  // means "not written yet" and falls back to the fixed i18n copy
  // (storyHead/storyBody) so every existing project card keeps working.
  storyQuote String @default("")
  storyBody  String @default("")

  // Badges & Honors
  medal String @default("oro")
  rank  String @default("aprendiz")
  // "Gente contactada" dot flanking the name, left side (2026-09-16) — was
  // fully simulated (`medalById("plata")` hardcoded) until now. Real field,
  // same key space as `medal` (lib/data.ts MEDALS, or Program.contactsScale
  // when set) so the picker/render logic is identical — the *count* behind
  // it is still not tracked anywhere, only the tier label is real now.
  contacts String @default("plata")

  // Contact channels (the ones exposed by the Editor screen)
  wa     String @default("")
  ig     String @default("")
  li     String @default("")
  x      String @default("")
  fb     String @default("")
  tiktok String @default("")
  yt     String @default("")
  web    String @default("")
  // Email/ubicación (2026-09-17) — mismo patrón que el resto de Canales
  // de Contacto, sin URL builder propio todavía (email es un mailto:
  // simple, ubicación es texto libre mostrado tal cual).
  email    String @default("")
  location String @default("")

  // Media
  portraitUrl       String?
  videoThumbnailUrl String?
  // Privacidad entre las 3 tarjetas de un Member (2026-09-19, pedido de
  // Gunnar): qué otros `kind` sumar al carrusel cuando ALGUIEN ABRE
  // ESTA tarjeta puntual — vacío (default) = esta tarjeta se ve sola,
  // nunca revela las otras 2 sin que el dueño lo prenda a mano. Antes,
  // abrir cualquiera de las 3 siempre mostraba las 3 juntas.
  shareScope Json @default("[]")

  // Company's own logo, rendered as the Virtual Office trigger instead of
  // the fixed gem SVG (PLAN.md, "independencia por tarjeta", 2026-09-16).
  // Project cards use program.logoUrl instead; personal keeps the gem.
  logoUrl           String?

  // Display defaults for first paint (viewer can still toggle)
  defaultTheme String @default("dark")
  defaultLang  String @default("es")

  // Tamaños ajustables por el dueño (2026-09-23, pedido de Gunnar: "que
  // pueda reducir la foto un poco, aumentar el botón de QR") -- por Card,
  // no por Programa: cada dueño ajusta la suya. Record<CardSizeKey,
  // number> (multiplicador 0.5-1.5), ver lib/cardSizeConfig.ts. Vacío
  // (el default) = 100% en los 4 módulos, cero cambio visual hasta que
  // el dueño lo toque.
  sizeConfig Json @default("{}")

  registrations Registration[]

  // --- Multi-program platform (PLAN.md Phase 0) ---
  // Purely additive: nothing reads these yet, existing cards default to
  // kind="project" with no member/program attached (still resolved by
  // slug the way every card is today). Wiring this into the public
  // rendering / ownership logic is a later, reviewed step — see PLAN.md.
  kind      String   @default("project") // project | company | personal
  memberId  String?
  member    Member?  @relation(fields: [memberId], references: [id])
  programId String?
  program   Program? @relation(fields: [programId], references: [id])

  // Virtual Office content (PLAN.md Fase 7) — company reads this as a
  // portfolio/catalog, personal as a résumé/gallery; each entry is
  // {id,title,subtitle?,description?,imageUrl?}. Project cards ignore this
  // and show their OriginMemento instead (their own recruitment story, not
  // editable content), so this stays empty for them.
  officeItems Json @default("[]")

  // The one root/genesis Card of the whole platform (Einar Horn /
  // MasterN0, 2026-09-16) — doesn't need a Member session or an Admin
  // login to count as "host": it IS the origin the referral fractal
  // activates from, so any visitor sees host mode (real QR, onboarding
  // trigger) on it. MasterN0-only toggle in the Card editor; expected to
  // be true on exactly one Card at a time, not DB-enforced.
  isOrigin Boolean @default(false)

  // PLAN.md Fase 9.2 — when set, siglas/tooltip/O.D.-modal body are read
  // from this Puesto instead of the fields above (which stay as a frozen
  // snapshot + the fallback for cards with no Program or no Puesto chosen
  // yet). SetNull on delete so a removed Puesto doesn't blank the card —
  // it just reverts to its own snapshot.
  puestoId String?
  puesto   Puesto? @relation(fields: [puestoId], references: [id], onDelete: SetNull)

  // Label shown in the top "island" (2026-09-16) — company/personal only,
  // editable, default "My Business Card"/"My Personal Card" in LyCardView
  // when empty. A project card's island label is computed from its
  // Program's name instead, no field needed.
  islandLabel String @default("")

  // A Company's own client network (PLAN.md, "independencia por tarjeta",
  // 2026-09-16) — same referral-chain shape as ProgramMembership, but
  // rooted at this specific Card instead of a Program. Empty for
  // project/personal (project has ProgramMembership instead; personal has
  // no fractal at all, just a contact list).
  networkMemberships CardNetworkMembership[]

  // --- Oficina Virtual: resumen ejecutivo (Fase E1, 2026-09-19) ---
  // "Keep in Flow" — objetivo corto del dueño en su programa/negocio,
  // texto libre. Vacío = no escrito todavía, la Oficina cae al fallback
  // fijo (cáscara honesta, mismo criterio que el resto del proyecto).
  oficinaObjetivo String @default("")

  // "Check de Realidad" — KPIs del día del negocio/programa. Array de
  // {key,label,value,unit,trend:[n,...]}, parseado en lib/oficinaExtras.ts.
  // Vacío cae a DEFAULT_REALITY_CHECK_KPIS (ejemplo real para Legacy:
  // Gemelos Digitales + Oficinas Virtuales), marcado como ejemplo en la UI.
  realityCheckKpis Json @default("[]")

  // Sección informativa de la Oficina — noticias/tareas cortas. Array de
  // {id,title,body,date}.
  newsItems Json @default("[]")

  // Calendario — próximos eventos/tareas, vista de lista. Array de
  // {id,title,date,time?}.
  calendarEvents Json @default("[]")

  // Marca una Card generada por el ambiente de datos demo (Fase E5) —
  // permite identificarla y borrarla en bloque, nunca mezclada con el
  // roster real.
  isDemo Boolean @default(false)

  voiceNotes VoiceNote[]
  leads      CardLead[]
  tags       Tag[]

  // WowStore (2026-09-24) — WowApps instaladas en ESTA Card puntual
  // (típicamente company/personal, un negocio MiPyME) — independiente
  // de Program.officeSkills, ver WowAppInstall.
  wowAppInstalls WowAppInstall[]

  // WowAwe (2026-09-24) — entradas de la caminata de asombro semanal.
  aweWalkEntries AweWalkEntry[]
}

// Sistema de Tags — pedido de Gunnar (2026-09-23), base de "Janus", el
// motor de emparejamiento "todos contra todos": cualquier Card (project,
// company o personal) puede marcar cosas que OFRECE y cosas que BUSCA,
// texto libre — desde una certificación industrial real (caso B4W, ver
// PLAN.md) hasta "tengo un sandwich de miga". El cruce entre el `busco`
// de una Card y el `ofrezco` de todas las demás es lo que arma un match
// (lib/janus.ts) — corre sobre TODA la red, no solo dentro de un
// Programa. `normalized` se guarda aparte de `text` para no recalcular
// minúsculas/acentos en cada consulta de cruce. `source` siempre
// "manual" hoy (lo carga el N0 a mano) — el campo existe desde el día
// uno para que, cuando una IA cargue tags sola más adelante, sea la
// MISMA fila/action, sin migrar el schema de nuevo.
model Tag {
  id     String @id @default(cuid())
  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  text       String
  normalized String
  polarity   String // "ofrezco" | "busco"
  category   String @default("") // libre, sugerido: producto | servicio | certificacion | talento | oportunidad
  source     String @default("manual") // "manual" | "ai"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cardId])
  @@index([polarity, normalized])
}

// Skill "Notas de Voz" (2026-09-19, pedido urgente de Gunnar — Skill #3
// del catálogo confirmado). Grabás, se sube el audio, y se transcribe +
// resume vía un proveedor externo (lib/transcription.ts) — degradado
// honesto sin `ASSEMBLYAI_API_KEY`: la nota queda en status "processing"
// para siempre y la UI dice "todavía sin conectar", mismo criterio que
// Fathom cuando no hay API key.
model VoiceNote {
  id     String @id @default(cuid())
  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  audioUrl String
  // "processing" (subida, sin transcribir o esperando el proveedor) |
  // "ready" (transcript+summary reales) | "error" (el proveedor falló).
  status String @default("processing")

  transcript String? @db.Text
  summary    String? @db.Text

  // id del job en el proveedor externo — para hacer polling de estado sin
  // guardar nada más suyo hasta que esté listo.
  providerJobId String?

  // El motivo real cuando status="error" — antes se descartaba en
  // silencio (2026-09-23, "dio error en la transcripción" sin poder ver
  // por qué). Nunca se le muestra en crudo a un visitante, solo al dueño.
  errorDetail String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cardId])
  aweWalkEntry AweWalkEntry?
}

// WowAwe (2026-09-24) — WowApp real (no cáscara "próximamente" como el
// resto del catálogo de ejemplo) basada en el estudio de "Awe Walks":
// salir a caminar, sacarse 3 selfies (inicio/medio/fin) y grabar una
// nota contando qué vio. La nota de voz es 100% real (mismo pipeline de
// siempre, VoiceNote + AssemblyAI). El "Índice de Asombro" es 100%
// SIMULADO -- nunca hay análisis real de encuadre/sonrisa en las fotos
// (eso es visión por computadora de investigación, no algo que este
// proyecto tenga construido) -- cáscara honesta, mismo criterio que el
// resto de LyCard.
model AweWalkEntry {
  id     String @id @default(cuid())
  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  photoStartUrl String @default("")
  photoMidUrl   String @default("")
  photoEndUrl   String @default("")

  voiceNoteId String?    @unique
  voiceNote   VoiceNote? @relation(fields: [voiceNoteId], references: [id], onDelete: SetNull)

  // 0-100, generado con una fórmula simple al azar -- ver
  // lib/aweWalk.ts. Nunca presentado como medición clínica real.
  aweIndex Int @default(0)

  createdAt DateTime @default(now())

  @@index([cardId])
}

// Seguimiento de a quién le compartiste tu LyCard y qué pasó después —
// pedido explícito de Gunnar (2026-09-23), a propósito más chico que el
// CRM de Sherpa/5-sesiones del roadmap (docs/05-ROADMAP-EDT.md): acá no
// hay puntaje de calidad ni asignación de Sherpa, es solo "quién recibió
// o interactuó con esta Card puntual, en qué estado quedó, y notas a
// mano del dueño". Estrictamente por Card — cada una de tus 3 Cards
// (project/company/personal) tiene su propio seguimiento, nunca
// mezclado entre ellas (ver `assertOwner` en leads-actions.ts).
//
// Se llena solo (upsertLead, en lib/leads.ts) desde 4 puntos reales de
// la app: invitación por mail, QR por WhatsApp, mensaje de contacto
// entrante, y "Agendar tu Entrevista" — nunca por conteo falso, solo
// cuando esa acción realmente tuvo éxito. El dueño puede además agregar
// uno a mano (alguien que conoció offline) y mover el estado/notas.
model CardLead {
  id     String @id @default(cuid())
  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  name    String @default("")
  contact String // email o whatsapp, lo que haya dado esa persona

  // "invitacion" | "qr_whatsapp" | "mensaje" | "entrevista" | "manual"
  source String

  // "compartido" | "contactado" | "en_seguimiento" | "convertido" | "perdido"
  // Los primeros 3 los mueve el sistema solo (nunca hacia atrás, nunca
  // hacia "convertido"/"perdido" — esos dos son terminales, solo el
  // dueño los setea a mano). Ver bumpStage() en lib/leads.ts.
  stage String @default("compartido")

  notes String? @db.Text

  // Link opcional a la Registration real si source="entrevista" — no
  // duplica esos datos, solo referencia.
  registrationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cardId])
}

// A brand/project running on the platform (Legacy today; Mlqr, Digital
// Kingdom, etc. later). Only the platform's single Admin (MasterN0) can
// create one — see PLAN.md Fase 6. Holds the official branding + social
// channels that every "project"-kind Card under it inherits, instead of
// each host editing their own.
model Program {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  logoUrl           String?
  // Nombre de la app y favicon del navegador para las Cards de este
  // Programa (2026-09-19, pedido de Gunnar) — vacío cae a "LyCard" +
  // el ícono genérico de siempre; con logoUrl+cardAppName cargados
  // (ej. "Legacy Card" + el logo real de Legacy) reemplazan ambos en
  // /c/[slug] y /c/[slug]/oficina. Reusa logoUrl (arriba), no hace
  // falta un campo de favicon aparte.
  cardAppName       String   @default("")
  primaryColor      String   @default("#C8A15A")
  videoThumbnailUrl String?
  wa                String   @default("")
  ig                String   @default("")
  li                String   @default("")
  x                 String   @default("")
  fb                String   @default("")
  tiktok            String   @default("")
  yt                String   @default("")
  web               String   @default("")
  // Off hides it from new joins/recruiting without touching existing cards
  // or members — a soft pause, not a delete (Gunnar's QA pass, Fase 7.1).
  active            Boolean  @default(true)
  // Overrides for button/modal title text on project cards under this
  // Program — Map<labelKey,string>, see lib/cardLabels.ts for the fixed
  // list of overridable keys. Missing/empty key falls back to the i18n
  // default (lib/i18n.ts). Shortcut version of the full per-Program
  // identity system in PLAN.md Fase 9 — titles only, not full content.
  cardLabels        Json     @default("{}")
  // Program-defined tier scales (PLAN.md Fase 9.4/9.5) — each is an
  // ordered array of {key,nombre,subtitulo,icono,color,descripcion}.
  // Empty array (the default) means "use the fixed scale in lib/data.ts",
  // same non-breaking fallback pattern as everything else in Fase 9 —
  // existing Cards' medal/rank values keep resolving exactly as before.
  medalScale        Json     @default("[]")
  rankScale         Json     @default("[]")
  // Same idea for the "gente contactada" dot (2026-09-16) — empty means
  // "use the fixed MEDALS list in lib/data.ts", same as medalScale.
  contactsScale     Json     @default("[]")
  // "Superpoderes" de la Oficina Virtual (2026-09-18) — array ordenado de
  // {key,nombre,descripcion,iconUrl,color,appType,enabled}, ver
  // lib/officeSkills.ts. Mismo patrón que medalScale/rankScale: vacío
  // (el default) cae a DEFAULT_OFFICE_SKILLS en vez de dejar la sección
  // vacía el primer día.
  officeSkills      Json     @default("[]")
  // Uploaded brand-guidelines image + what got "read" from it (2026-09-16)
  // — {imageUrl, palette: string[] hex, font, buttonStyle, extractedAt}.
  // The color palette is real (extracted client-side from the actual
  // pixels); font/buttonStyle are simulated until there's a real model —
  // see lib/designExtraction.ts for the one place that changes. Empty
  // object means nothing uploaded yet.
  brandDesign       Json     @default("{}")
  // Pool de frases motivacionales del "Keep in Flow" (Fase E1,
  // 2026-09-19) — array de strings, editado a mano por el N0 (mismo
  // patrón que officeSkills). pickPhraseOfTheDay() en lib/oficinaExtras.ts
  // elige una distinta por día del año, determinístico — nada de IA en
  // vivo generándola (decisión explícita del alcance de este MVP).
  motivationalPhrases Json @default("[]")
  // Marca un Program generado por el ambiente de datos demo (Fase E5).
  isDemo              Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  memberships ProgramMembership[]
  cards       Card[]
  admins      Admin[]
  puestos     Puesto[]
  skins       ProgramSkin[]
  interviewSlots InterviewSlot[]
  messages    Message[]
}

// Mensajería Interna (2026-09-24) -- ver PLAN.md "Mensajería Interna".
// N0 manda "masivo" a todo su Programa (o multi-Programa si es
// MasterN0, resuelto en la action, no en el schema); cualquier otro
// humano solo "directo" 1:1 con alguien de su mismo Programa. N1
// (tríada Gemelo Digital) y N2 (guardianas) nunca participan -- no son
// Member, así que ni siquiera pueden aparecer acá.
model Message {
  id        String   @id @default(cuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  // Exactamente uno de los dos está seteado -- ver el wrinkle
  // documentado en PLAN.md: no todo N0 tiene un Member propio (un N0
  // "clásico" de /admin/programs, email/password, puede no tenerlo).
  senderMemberId String?
  senderMember   Member? @relation(fields: [senderMemberId], references: [id])
  senderAdminId  String?
  senderAdmin    Admin?  @relation(fields: [senderAdminId], references: [id])

  scope String // "masivo" | "directo"
  body  String @db.Text

  createdAt DateTime @default(now())

  deliveries MessageDelivery[]

  @@index([programId])
}

model MessageDelivery {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  recipientMemberId String
  recipient         Member @relation(fields: [recipientMemberId], references: [id], onDelete: Cascade)

  channel String // "lycard" | "email" | "telegram" | "whatsapp"
  // "pendiente" | "enviado" | "fallido" | "simulado" -- nunca "enviado"
  // si el canal no mandó nada de verdad (cáscara honesta, mismo
  // criterio que membershipPaidAt/adaptationStatus).
  status      String  @default("pendiente")
  errorDetail String?

  // Leído/no leído para la bandeja LyCard interna -- solo tiene sentido
  // real quando channel="lycard" (los otros canales no tienen "leído"
  // que este sistema pueda saber).
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([messageId])
  @@index([recipientMemberId])
}

// Auditoría 2026-09-23, hallazgo 1.4/2.1: lib/interviewSlots.ts era un
// array hardcodeado, sin cupo y sin lógica de vencimiento -- un slot ya
// pasado seguía siendo reservable en vivo. Esta es la resolución real,
// por Programa (mismo patrón que Puesto: fila propia, no un JSON
// compartido, porque necesita contar Registrations reales contra un id
// estable). No reemplaza lib/interviewSlots.ts todavía -- un Programa sin
// filas acá sigue cayendo al array fijo como fallback, mismo criterio
// honesto de "nunca una sección vacía el primer día" que ya usan
// officeSkills/escalas.
model InterviewSlot {
  id        String   @id @default(cuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  label     String
  labelEn   String
  date      DateTime // fecha real del slot -- se compara contra "hoy" para no ofrecerlo vencido
  time      String   // texto de display, ej. "18:00 hs (GMT-6)"
  capacity  Int      @default(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registrations Registration[]

  @@index([programId])
}

// A saved brand skin for a Program (2026-09-16, noche) — up to 3 per
// Program, at most one active at a time. Supersedes Program.brandDesign
// (kept in the schema, unused going forward, to avoid a destructive
// migration). Built from a design.md file (e.g. exported by Google
// Stitch), parsed with lib/designMd.ts: real text extraction (hex codes,
// font name, button-style keywords) — best-effort since Stitch's export
// isn't a fixed schema, with sane fallbacks to today's fixed gold/dark
// palette for anything it can't find. `colors` shape: {bg, surf, surf2,
// ink, ink2, accent, accentDark} — border/glow/shadow variants get
// derived from these at render time, not stored.
model ProgramSkin {
  id          String   @id @default(cuid())
  programId   String
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  name        String
  designMdRaw String   @db.Text
  colors      Json
  // Segundo set de colores, para modo claro (2026-09-18, pedido de
  // Gunnar) — mismo shape que `colors` (SkinColors), de un segundo
  // design.md opcional. Null mientras no se suba: el toggle claro/oscuro
  // de la tarjeta sigue oculto con un skin activo hasta que este campo
  // tenga algo, para no mostrar un botón que no cambia nada (mismo
  // criterio que ya regía antes de esto).
  lightColors Json?
  font        String
  buttonStyle String
  active      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([programId])
}

// A position/role within a Program's own hierarchy (PLAN.md Fase 9.1) —
// e.g. Legacy's O.D. → Founders → Experts → Specialists → Partners
// ladder. Only the N0 builds this list; a project Card picks one instead
// of writing its own siglas/denominación/descripción by hand.
model Puesto {
  id           String   @id @default(cuid())
  programId    String
  program      Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  siglas       String
  denominacion String
  descripcion  String
  order        Int      @default(0)
  // Material Symbols name shown on the O.D. badge next to `siglas` on the
  // public card (2026-09-16) — was hardcoded to "diamond" everywhere until
  // now; editable per Puesto same as a rank tier's `icono`.
  icono        String   @default("diamond")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cards Card[]

  @@index([programId])
}

// A real person, distinct from Admin (the platform superuser). Owns up to
// three Cards (project/company/personal — see PLAN.md Fase 0/5) once
// their membership is active. whatsapp is meant to be the primary
// credential (PLAN.md Fase 1) but is nullable because a Google-first
// signup won't have it yet — added later from their own dashboard.
model Member {
  id        String   @id @default(cuid())
  whatsapp  String?  @unique
  email     String   @default("")
  googleId  String?  @unique
  name      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Conexión real de Google más allá del login (Fase F, 2026-09-19) —
  // separada de googleId/OIDC de arriba: esto es consentimiento offline
  // adicional (Calendar + Tasks + Drive-file) para que EinarOS pueda
  // escribir eventos/tareas reales y, para el N0, su carpeta Bridge en
  // Drive (Protocolo Dirac). Null = todavía no conectó, se usa la
  // versión simulada en su lugar (cáscara honesta).
  googleRefreshToken   String?
  googleScopes         String?
  googleConnectedAt    DateTime?
  googleBridgeFolderId String?

  memberships        ProgramMembership[]
  cards              Card[]
  origin             OriginMemento?
  networkMemberships CardNetworkMembership[]
  // No-null cuando este Member fue promovido a N0 de su propio Programa
  // (2026-09-24) -- ver Admin.memberId arriba.
  promotedAdmin      Admin?

  // Mensajería Interna (2026-09-24) — este Member como remitente (solo
  // cuando llegó a ser N0 vía la promoción de Fase P1, ver
  // Message.senderMemberId) y como destinatario de cualquier envío.
  sentMessages      Message[]
  messageDeliveries MessageDelivery[]
}

// A simulated WhatsApp OTP (PLAN.md Fase 1 — real sending is Fase 8).
// Short-lived, one-time use, scoped to a phone number rather than an
// existing Member since the first login for a new person IS how their
// Member row gets created.
model OtpCode {
  id        String    @id @default(cuid())
  whatsapp  String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([whatsapp])
}

// A Member's standing within one Program — tracks the referral tree
// (referredBy) and onboarding progress. "active" is what unlocks the
// member's own project/company/personal cards (PLAN.md Fase 4).
model ProgramMembership {
  id                     String   @id @default(cuid())
  memberId               String
  member                 Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  programId              String
  program                Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  referredByMembershipId String?
  referredBy             ProgramMembership?  @relation("Referrals", fields: [referredByMembershipId], references: [id])
  referred               ProgramMembership[] @relation("Referrals")
  status                 String    @default("invited") // invited | interviewed | active
  interviewedAt          DateTime?
  membershipPaidAt       DateTime? // marcado a mano por el admin -- no hay pasarela de pago real todavía
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  registrations Registration[]

  @@unique([memberId, programId])
}

// A Company Card's own client network (PLAN.md, "independencia por
// tarjeta", 2026-09-16) — same referral-chain shape as ProgramMembership
// (referredByMembershipId), but rooted at a specific Card instead of a
// Program: the Company's owner is that network's N0 by definition, no row
// of their own needed. Created (status "invited") when a visitor books a
// meeting via registerInterviewAction; flipped to "active" the same way a
// ProgramMembership is — a human admin/owner action, not automatic (see
// the Company admin panel, PLAN.md "Qué sigue").
model CardNetworkMembership {
  id                     String                  @id @default(cuid())
  cardId                 String
  card                   Card                    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  memberId               String
  member                 Member                  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  referredByMembershipId String?
  referredBy             CardNetworkMembership?  @relation("CardReferrals", fields: [referredByMembershipId], references: [id])
  referred               CardNetworkMembership[] @relation("CardReferrals")
  status                 String                  @default("invited") // invited | active
  interviewedAt          DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  registrations Registration[]

  @@unique([memberId, cardId])
}

// Snapshot of "the card that recruited me" archived into a Member's own
// Virtual Office once they graduate from guest to host (PLAN.md Fase 4) —
// the live guest-mode view disappears, this is what's left of it.
model OriginMemento {
  id        String   @id @default(cuid())
  memberId  String   @unique
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  snapshot  Json
  createdAt DateTime @default(now())
}

// A visitor signing up for one of a card's (currently hardcoded, see
// lib/interviewSlots.ts) interview slots via the "Agendar tu Entrevista"
// modal. slotId/slotLabel are a snapshot of the slot they picked — slots
// aren't DB rows yet, so nothing to foreign-key against.
model Registration {
  id        String   @id @default(cuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  slotId    String
  slotLabel String
  name      String
  whatsapp  String
  email     String   @default("")
  createdAt DateTime @default(now())

  // Set cuando el slot elegido es una fila real de InterviewSlot (cupo
  // real por Programa, Auditoría 2026-09-23) en vez de uno de los 4
  // hardcodeados en lib/interviewSlots.ts. slotId/slotLabel arriba
  // siguen llenándose siempre igual (snapshot legible), este es el que
  // habilita contar cupo real.
  interviewSlotId String?
  interviewSlot   InterviewSlot? @relation(fields: [interviewSlotId], references: [id], onDelete: SetNull)

  // Linked when the visitor registering is a logged-in Member with a
  // membership in the Program behind the card (PLAN.md Fase 4) — nullable so
  // anonymous registrations (or ones predating this) keep working untouched.
  membershipId String?
  membership   ProgramMembership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  // Same idea, for a booking against a Company card's own client network
  // (2026-09-16) — set/found-or-created in registerInterviewAction when
  // card.kind === "company" and the visitor is a logged-in Member.
  networkMembershipId String?
  networkMembership   CardNetworkMembership? @relation(fields: [networkMembershipId], references: [id], onDelete: SetNull)

  @@index([cardId])
  @@index([membershipId])
  @@index([networkMembershipId])
}

// WowStore (2026-09-24) — appstore de WowApps pensado para cualquier
// MiPyME (restaurante, retail, despacho, emprendedor), navegado por
// rubro+dolor, no por categoría técnica. Catálogo curado por MasterN0
// desde /admin/wowstore, distinto de Program.officeSkills (eso sigue
// siendo el catálogo INTERNO de Legacy para su propio equipo) -- ver
// PLAN.md "WowStore -- Fase W1" para el porqué de la separación.
model WowApp {
  id        String   @id @default(cuid())
  key       String   @unique
  nombre    String
  descripcion String
  iconUrl   String   @default("")
  color     String   @default("#C8A15A")
  // "agenda" | "whatsapp-bot" | "cobranza" | "custom" -- qué componente
  // real corre adentro cuando está instalada, ver lib/wowApps.ts.
  appType   String   @default("custom")
  // string[] serializados -- rubro ("restaurante","retail",...) y dolor
  // ("vender-mas","inventario",...), parseados en lib/wowApps.ts.
  industryTags  Json @default("[]")
  painPointTags Json @default("[]")
  basePriceUsd  Float  @default(0)
  // "activo" | "proximamente" -- nunca se muestra como funcional si no
  // lo es, cáscara honesta.
  status        String @default("proximamente")
  demoVideoUrl  String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  installs WowAppInstall[]
}

model WowAppInstall {
  id       String @id @default(cuid())
  cardId   String
  card     Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  wowAppId String
  wowApp   WowApp @relation(fields: [wowAppId], references: [id], onDelete: Cascade)

  installedAt DateTime @default(now())

  // Adaptación a medida, paga -- mismo criterio honesto que
  // ProgramMembership.membershipPaidAt: flag marcado a mano, todavía
  // sin pasarela de pago real. El pedido en sí llega por email al
  // equipo (Sergio/Fabricio), no hay backend automatizado.
  adaptationNotes  String    @default("")
  adaptationStatus String    @default("sin_pedir") // sin_pedir | pendiente | en_progreso | entregada
  adaptationPaidAt DateTime?

  @@unique([cardId, wowAppId])
}

// --- Módulo HR/PM (docs/05-ROADMAP-EDT.md) ---
// Panel interno /admin/equipo, MasterN0-only — separado de las Oficinas
// de cliente. Un Node NO es siempre "humano + agente": puede ser un
// Agente Legacy (humano+Agente fusionados), un Agente Silicio (agente
// puro, sin humano, creado directo por el N0), o una referencia Carbono
// (persona real mapeada, sin ser agente todavía) — ver la sección
// "Escalera Fractal" del roadmap para la taxonomía completa.
model Node {
  id             String   @id @default(cuid())
  name           String
  rung           String // "N0".."N12", con "N1.1" como único sub-escalón (Einar)
  nodeType       String // "legacy" | "silicio" | "carbono_ref"
  reportsToN11Id String? // el N1.1 al que reporta — todo el resto del fractal habla solo con su propio N1.1, nunca directo con MasterN0
  role           String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tasks Task[]

  @@index([rung])
}

// Vista PM (mismo dato que Node, otro corte): un proyecto/iniciativa real
// del equipo — LyCard, el MVP del partido MLQR, esta documentación,
// Panel NashMesh, etc. — con su nivel de autonomía delegada (ψ) y avance.
model ProjectNode {
  id                 String    @id @default(cuid())
  name               String
  ownerNodeId        String // quién lo dueño/lleva
  level              Int       @default(1) // 1=Autónomo ψ15% 2=Override ψ35% 3=Directo ψ100%
  domain             String    @default("")
  progressPct        Int       @default(0)
  nextMilestoneTitle String    @default("")
  nextMilestoneDate  DateTime?
  blockers           Json      @default("[]") // string[]
  responsibleNodeId  String // quién responde por el resultado — puede ser distinto del owner
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tasks Task[]

  @@index([ownerNodeId])
  @@index([responsibleNodeId])
}

model Task {
  id        String   @id @default(cuid())
  projectId String
  project   ProjectNode @relation(fields: [projectId], references: [id], onDelete: Cascade)
  nodeId    String
  node      Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  title     String
  status    String   @default("pendiente") // pendiente | en_curso | hecho | bloqueado
  due       DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([nodeId])
}

// NashMesh (pedido de Gunnar, 2026-09-23) — el motor de reparto:
// Payment_i = φ_i (Shapley, acá simplificado a "contribución declarada
// a mano") × ψ_i (Reliability Weight, tres niveles fijos 0.15/0.35/1.0)
// × (1-ε) (comisión de plataforma). Primera versión, SOLO simulación —
// cero movimiento de dinero real, confirmado con Gunnar que blockchain
// no es parte de este MVP. Se dispara típicamente al confirmar un cruce
// real de Janus (ver /admin/janus) — participants/outputs quedan en Json
// como snapshot histórico (no FK a Card: un run vieja sigue siendo
// válida aunque esa Card se borre después), cardId es opcional a
// propósito porque un participante puede no estar en el sistema todavía
// (ej. "el Estado" como financiador, en el caso B4W).
model NashMeshRun {
  id            String   @id @default(cuid())
  label         String
  totalValueUsd Float
  epsilon       Float    @default(0.05)
  isSimulation  Boolean  @default(true)
  participants  Json // [{cardId?, name, declaredContributionPct, psiTier}]
  outputs       Json // [{cardId?, name, phi, psi, payment}]
  createdAt     DateTime @default(now())
}
