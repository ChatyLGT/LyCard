DATABASE_URL="postgresql://user:password@localhost:5432/lycard?schema=public"

SESSION_SECRET="generate a long random string, e.g. openssl rand -hex 32"

NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Vercel Blob — leave unset locally to fall back to disk storage under public/uploads.
BLOB_READ_WRITE_TOKEN=""

# Only read by `pnpm db:seed`, to bootstrap the first Master Admin account.
# Change the password from /admin/account right after logging in once.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-immediately"
