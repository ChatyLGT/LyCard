DATABASE_URL="postgresql://user:password@localhost:5432/lycard?schema=public"

SESSION_SECRET="generate a long random string, e.g. openssl rand -hex 32"

NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Vercel Blob — leave unset locally to fall back to disk storage under public/uploads.
BLOB_READ_WRITE_TOKEN=""

# Resend — powers the "Enviar Invitación" button on the public card. Leave
# unset to keep that feature disabled (it fails gracefully with a message
# in the UI instead of sending). Get a key at https://resend.com.
RESEND_API_KEY=""
# Must be on a domain verified in Resend; the default onboarding@resend.dev
# sender only works for testing (deliverable to your own Resend account email).
RESEND_FROM="Legacy Program <onboarding@resend.dev>"

# Google Sign-In for Members (/m/login) — PLAN.md Fase 1. Leave unset to
# keep that button inert (it redirects back with an error instead of
# crashing). Create OAuth 2.0 credentials at
# https://console.cloud.google.com/apis/credentials — Web application type,
# authorized redirect URI: {NEXT_PUBLIC_BASE_URL}/m/auth/google/callback.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Only read by `pnpm db:seed`, to bootstrap the first Master Admin account.
# Change the password from /admin/account right after logging in once.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-immediately"
